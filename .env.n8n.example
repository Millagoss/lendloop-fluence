# Prefer `npm run setup:secrets` to generate random local secrets.
N8N_ENCRYPTION_KEY=
N8N_RUNNERS_AUTH_TOKEN=
CONVEX_TO_N8N_SECRET=
N8N_TO_CONVEX_SECRET=
# Hosted Convex: https://YOUR-DEPLOYMENT.convex.site (NOT .convex.cloud)
# Local backend, as reached from Docker:
CONVEX_SITE_URL=http://host.docker.internal:3211
